<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="..\VallentaDesigner.Common.props"/>
    <PropertyGroup>
        <ProjectGuid>{5C40202C-BEDB-4AB5-9883-AAA0CF5BCCCA}</ProjectGuid>
        <ProjectVersion>20.4</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <MainSource>VallentaDesignerTests.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Console</AppType>
        <ProjectName Condition="'$(ProjectName)'==''">VallentaDesignerTests</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Cfg_1)'=='true') or '$(Cfg_1_Win32)'!=''">
        <Cfg_1_Win32>true</Cfg_1_Win32>
        <CfgParent>Cfg_1</CfgParent>
        <Cfg_1>true</Cfg_1>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_ExeOutput>.\bin\$(Platform)\$(Config)\$(ProductVersion)</DCC_ExeOutput>
        <DCC_DcuOutput>.\dcu\$(Platform)\$(Config)\$(ProductVersion)</DCC_DcuOutput>
        <DCC_ConsoleTarget>true</DCC_ConsoleTarget>
        <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;System;Xml;Data;Datasnap;Web;Soap;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>..\src\Core;..\src\Streaming;..\src\Packages;..\src\DesignTime;..\src\Surface;..\src\Palette;..\src\Inspector;..\src\Shell;$(DUNITX)\Source;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <UsePackages>true</UsePackages>
        <DCC_UsePackage>rtl;vcl;designide;$(DCC_UsePackage)</DCC_UsePackage>
        <SanitizedProjectName>VallentaDesignerTests</SanitizedProjectName>
        <VerInfo_Locale>1033</VerInfo_Locale>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1_Win32)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_DebugInformation>0</DCC_DebugInformation>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="Vallenta.FormEditor.Tests.Environment.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.RoundTrip.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.SingleInstance.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Protocol.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.FieldDiff.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Coupling.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Rename.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Orphan.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Recovery.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.SettledImage.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.SourceFiles.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.ArgumentFile.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.LoadedClasses.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.SearchPath.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.LinkedModules.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Log.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Palette.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Layout.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Tiles.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.DesignerDiscovery.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.DesignHitTest.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.IdeServices.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Diagnostics.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.ZOrder.pas"/>
        <DCCReference Include="Vallenta.FormEditor.Tests.Clipboard.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">VallentaDesignerTests.dpr</Source>
                </Source>
                <Excluded_Packages>
                    <Excluded_Packages Name="$(BDSBIN)\dcloffice2k370.bpl">Microsoft Office 2000 Sample Automation Server Wrapper Components</Excluded_Packages>
                    <Excluded_Packages Name="$(BDSBIN)\dclofficexp370.bpl">Microsoft Office XP Sample Automation Server Wrapper Components</Excluded_Packages>
                </Excluded_Packages>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">False</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
